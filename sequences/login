"Driver Service" --> "API Gateway": oAuth Token

"API Gateway" --> Driver : oAuth token

Driver -> "API Gateway": /assignments/driver/{{driver_id}}/current

"API Gateway" -> "Driver Service" : /assignments/driver/{{driver_id}}/current

"Driver Service" --> "API Gateway" : Assigned Vehicle

"API Gateway" --> Driver: Assigned Vehicle 


